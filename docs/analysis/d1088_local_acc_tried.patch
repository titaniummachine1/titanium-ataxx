+#[cfg(test)]
+mod local_bench2 {
+    use super::*;
+    use crate::board::MoveList;
+
+    /// D1088: row-sum cost alone: the full list (what main adds per accumulator) vs the parent->child difference lists,
+    /// on precomputed lists (no extraction, no head), plus the head alone.
+    #[test]
+    #[ignore]
+    fn local_rowsum_timing() {
+        let net = Nnue::bundled_static();
+        let mut seed = 0x2545_F491_4F6C_DD1Du64;
+        let mut rnd = || {
+            seed ^= seed << 13;
+            seed ^= seed >> 7;
+            seed ^= seed << 17;
+            seed
+        };
+        let mut ml = MoveList::new();
+        let (mut full_l, mut add_l, mut sub_l): (Vec<Vec<u32>>, Vec<Vec<u32>>, Vec<Vec<u32>>) = (vec![], vec![], vec![]);
+        for _ in 0..60 {
+            let mut b = Board::start();
+            for _ in 0..100 {
+                b.legal_moves_dedup_into(&mut ml);
+                if ml.is_empty() || b.game_over() {
+                    break;
+                }
+                let (pu, pnu, _, _) = nnfeat::both(&b, net.groups);
+                let pu = &pu[..pnu];
+                for m in ml.iter().filter(|m| !m.is_pass()) {
+                    let c = b.make(m);
+                    // child's accumulator of the colour the parent had to move = child's `them` half
+                    let (_, _, ct, cnt) = nnfeat::both(&c, net.groups);
+                    let ct = &ct[..cnt];
+                    full_l.push(ct[..cnt - 3].to_vec());
+                    let (mut a, mut s) = (vec![], vec![]);
+                    for sq in 0..NSQ {
+                        if ct[sq] != pu[sq] {
+                            a.push(ct[sq]);
+                            s.push(pu[sq]);
+                        }
+                    }
+                    let (c3a, c3b) = g3_range(ct);
+                    let (p3a, p3b) = g3_range(pu);
+                    let (cg, pg) = (&ct[c3a..c3b], &pu[p3a..p3b]);
+                    for &f in cg { if !pg.contains(&f) { a.push(f); } }
+                    for &f in pg { if !cg.contains(&f) { s.push(f); } }
+                    a.extend_from_slice(&ct[NSQ..c3a]);
+                    a.extend_from_slice(&ct[c3b..cnt - 3]);
+                    add_l.push(a);
+                    sub_l.push(s);
+                }
+                b = b.make(ml.move_at((rnd() as usize) % ml.len()));
+            }
+        }
+        let n = full_l.len();
+        let mut out = [0i16; LA_W];
+        for rep in 0..3 {
+            let t = std::time::Instant::now();
+            for l in &full_l {
+                unsafe { net.ft_mix(out.as_mut_ptr(), &ZERO_ROW, &ZERO_ROW, l, &[]) };
+                std::hint::black_box(&out);
+            }
+            let tf = t.elapsed().as_nanos() as f64 / n as f64;
+            let t = std::time::Instant::now();
+            for i in 0..n {
+                unsafe { net.ft_mix(out.as_mut_ptr(), &ZERO_ROW, &ZERO_ROW, &add_l[i], &sub_l[i]) };
+                std::hint::black_box(&out);
+            }
+            let td = t.elapsed().as_nanos() as f64 / n as f64;
+            let rf: f64 = full_l.iter().map(|l| l.len()).sum::<usize>() as f64 / n as f64;
+            let rd: f64 = (0..n).map(|i| add_l[i].len() + sub_l[i].len()).sum::<usize>() as f64 / n as f64;
+            println!("rep {rep}: {n} accumulators: full rows {rf:.1} = {tf:.0} ns ({:.1} ns/row) | diff rows {rd:.1} = {td:.0} ns ({:.1} ns/row)", tf / rf, td / rd);
+        }
+    }
+}
