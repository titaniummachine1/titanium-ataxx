+    /// D1088: the partial incremental path (`LocalAcc`) needs W256, groups G1 + G3 and the pre-summed G6 table.
+    pub fn supports_local(&self) -> bool {
+        self.width == LA_W && self.groups & nnfeat::G1 != 0 && self.groups & nnfeat::G3 != 0 && self.g6tab.is_some()
+    }
