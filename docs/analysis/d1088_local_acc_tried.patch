+                b = b.make(ml.move_at((rnd() as usize) % ml.len()));
+            }
+        }
+        let nk: usize = parents.iter().map(|p| p.1.len()).sum();
+        let mut las = vec![LocalAcc::default(); parents.len()];
+        for rep in 0..3 {
+            let t = std::time::Instant::now();
+            for (i, (p, _)) in parents.iter().enumerate() {
+                net.local_build(p, &mut las[i]);
+            }
+            let tb = t.elapsed().as_nanos() as f64 / parents.len() as f64;
+            let mut s = 0i64;
+            let t = std::time::Instant::now();
+            for (_, kids) in &parents {
+                for c in kids {
+                    s += net.eval_with_dis(c, 0).0 as i64;
+                }
+            }
+            let tf = t.elapsed().as_nanos() as f64 / nk as f64;
+            let t = std::time::Instant::now();
+            for (i, (_, kids)) in parents.iter().enumerate() {
+                for c in kids {
+                    s -= net.eval_with_dis_inc(&las[i], c, 0).0 as i64;
+                }
+            }
+            let ti = t.elapsed().as_nanos() as f64 / nk as f64;
+            let t = std::time::Instant::now();
+            let mut us = [0u32; nnfeat::MAX_ACTIVE];
+            let mut th = [0u32; nnfeat::MAX_ACTIVE];
+            for (_, kids) in &parents {
+                for c in kids {
+                    let (a, b) = nnfeat::both_into(c, net.groups, &mut us, &mut th);
+                    s += (a + b) as i64 + us[3] as i64;
+                }
+            }
+            let tx = t.elapsed().as_nanos() as f64 / nk as f64;
+            println!("rep {rep}: {} parents, {nk} children: full {tf:.0} ns/child | local {ti:.0} ns/child | extraction {tx:.0} ns | local_build {tb:.0} ns/node (checksum {s})", parents.len());
+        }
+    }
+}
