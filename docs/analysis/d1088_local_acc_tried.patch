+    use crate::board::MoveList;
+
+    /// D1088: the partial incremental child eval is bit-identical to the full refresh, on every child of positions
+    /// reached by random play from the start (both colours to move, all phases).
+    #[test]
+    fn local_inc_eval_matches_full_refresh() {
+        let net = Nnue::bundled_static();
+        assert!(net.supports_local(), "bundled net must support the local path");
+        let mut seed = 0x9E37_79B9_7F4A_7C15u64;
+        let mut rnd = || {
+            seed ^= seed << 13;
+            seed ^= seed >> 7;
+            seed ^= seed << 17;
+            seed
+        };
+        let mut ml = MoveList::new();
+        let mut la = LocalAcc::default();
+        let mut checked = 0usize;
+        for _game in 0..40 {
+            let mut b = Board::start();
+            for _ply in 0..120 {
+                b.legal_moves_dedup_into(&mut ml);
+                if ml.is_empty() || b.game_over() {
+                    break;
+                }
+                net.local_build(&b, &mut la);
+                for i in 0..ml.len() {
+                    let m = ml.move_at(i);
+                    if m.is_pass() {
+                        continue;
+                    }
+                    let c = b.make(m);
+                    for s57 in [0, 137] {
+                        assert_eq!(net.eval_with_dis_inc(&la, &c, s57), net.eval_with_dis(&c, s57), "ply {_ply} move {i}");
+                    }
+                    checked += 1;
+                }
+                let k = (rnd() as usize) % ml.len();
+                b = b.make(ml.move_at(k));
+            }
+        }
+        assert!(checked > 20_000, "only {checked} children checked");
+    }
+}
