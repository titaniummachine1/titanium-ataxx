+/// D1088: accumulator width of the partial incremental path (the champion's W256)
+const LA_W: usize = 256;
+const NSQ: usize = 49;
+static ZERO_ROW: [i16; LA_W] = [0; LA_W];
+
+/// D1088: the LOCAL groups of a position's two accumulators, by absolute colour: G1 (one row per square) and G3 (one row
+/// per stone, ascending square) summed without the bias, plus their row lists for the parent -> child difference.
+#[derive(Clone)]
+pub struct LocalAcc {
+    acc: [[i16; LA_W]; 2],
+    g1: [[u32; NSQ]; 2],
+    g3: [[u32; NSQ]; 2],
+    n3: [usize; 2],
+}
+
+impl Default for LocalAcc {
+    fn default() -> Self {
+        LocalAcc { acc: [[0; LA_W]; 2], g1: [[0; NSQ]; 2], g3: [[0; NSQ]; 2], n3: [0; 2] }
+    }
+}
+
+/// [start, end) of the G3 rows in a `both_into` list (G1 49 | G2 | G3 ascending | G5 | G6 x3)
+#[inline(always)]
+fn g3_range(idx: &[u32]) -> (usize, usize) {
+    let (lo, hi) = (nnfeat::G3_OFF as u32, nnfeat::G5_OFF as u32);
+    let mut a = NSQ;
+    while a < idx.len() && idx[a] < lo {
+        a += 1;
+    }
+    let mut b = a;
+    while b < idx.len() && idx[b] < hi {
+        b += 1;
+    }
+    (a, b)
+}
