+    /// D1088: the LOCAL part (G1 square states + G3 stone rings, no bias) of both accumulators of `b`, by absolute colour.
+    pub fn local_build(&self, b: &Board, out: &mut LocalAcc) {
+        debug_assert!(self.supports_local());
+        let mut us = [0u32; nnfeat::MAX_ACTIVE];
+        let mut them = [0u32; nnfeat::MAX_ACTIVE];
+        let (nu, nt) = nnfeat::both_into(b, self.groups, &mut us, &mut them);
+        let t = b.turn as usize;
+        for (half, (idx, n)) in [(&us, nu), (&them, nt)].into_iter().enumerate() {
+            let c = if half == 0 { t } else { 1 - t };
+            let (g3a, g3b) = g3_range(&idx[..n]);
+            out.g1[c].copy_from_slice(&idx[..NSQ]);
+            let n3 = g3b - g3a;
+            out.g3[c][..n3].copy_from_slice(&idx[g3a..g3b]);
+            out.n3[c] = n3;
+            let mut add = [0u32; nnfeat::MAX_ACTIVE];
+            add[..NSQ].copy_from_slice(&idx[..NSQ]);
+            add[NSQ..NSQ + n3].copy_from_slice(&idx[g3a..g3b]);
+            // SAFETY: out.acc[c] holds LA_W lanes; ZERO_ROW holds LA_W lanes; every index is a row of ftq
+            unsafe { self.ft_mix(out.acc[c].as_mut_ptr(), &ZERO_ROW, &ZERO_ROW, &add[..NSQ + n3], &[]) };
+        }
+    }
