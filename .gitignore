# Build artifacts
/target
/target-*/
/target_*/
target/
web/pkg
web/dist
node_modules/

# Local scratch space (never pushed: gate .exes, moonbird, per-gate launchers, match logs)
/data/*
!/data/nnue/
/data/nnue/*
/logs
/scripts

# Binaries and weight blobs are NEVER versioned (Stockfish rule: build them,
# don't track them). Snapshot .exes live in scripts/bench/, nets in data/nnue/.
*.exe
*.dll
*.pdb
*.tup
*.s1
*.pt
*.npz
*.onnx
*.db
*.db-wal
*.db-shm

# Python bytecode
__pycache__/
*.pyc

# Misc
*.log
*.jsonl
*.tmp
.DS_Store
Thumbs.db

# Shipped champion eval (LAST so it overrides *.tup above): our own SGD
# weights, 28KB, main runs it by default. Every other blob stays out.
!/data/nnue/tupS37fix.tup
